{
  "name": "codex-to-im",
  "version": "1.0.40",
  "description": "Installable Codex-to-IM bridge with local setup UI and background service",
  "license": "MIT",
  "homepage": "https://github.com/zhangle1987/codex-to-im#readme",
  "bugs": {
    "url": "https://github.com/zhangle1987/codex-to-im/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangle1987/codex-to-im.git"
  },
  "type": "module",
  "files": [
    "dist/",
    "agents/",
    "docs/",
    "references/",
    "scripts/",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "README_EN.md",
    "SECURITY.md",
    "config.env.example"
  ],
  "bin": {
    "codex-to-im": "dist/cli.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/patch-codex-sdk-windows-hide.js",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "dev:ui": "tsx src/ui-server.ts",
    "open": "node dist/cli.mjs open",
    "weixin:login": "node --import tsx src/weixin-login.ts",
    "test": "node scripts/run-tests.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.62",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@openai/codex-sdk": "^0.116.0",
    "discord.js": "^14.25.1",
    "markdown-it": "^14.1.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
